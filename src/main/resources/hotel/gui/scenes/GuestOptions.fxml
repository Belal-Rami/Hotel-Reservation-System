<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hotel.gui.controllers.GuestOptionsController">
   <children>
      <ImageView fitHeight="1080.0" fitWidth="1920.0" mouseTransparent="true" preserveRatio="true">
         <image>
            <Image url="@Lokanda.png" />
         </image>
         <effect>
            <DropShadow />
         </effect>
      </ImageView>
      <HBox alignment="CENTER" spacing="300.0" AnchorPane.bottomAnchor="175.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onLoginChoice" prefHeight="145.0" prefWidth="267.0" style="-fx-background-color: #EFD16D; -fx-background-radius: 30;" text="Login">
               <font>
                  <Font name="System Bold" size="48.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#onRegisterChoice" prefHeight="133.0" prefWidth="276.0" style="-fx-background-color: #EFD16D; -fx-background-radius: 30;" text="Register">
               <font>
                  <Font name="System Bold" size="48.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <Button contentDisplay="GRAPHIC_ONLY" layoutX="69.0" layoutY="63.0" mnemonicParsing="false" onAction="#onBackClicked" prefHeight="85.0" prefWidth="110.0" style="-fx-background-color: transparent;" text="Button">
         <graphic>
            <ImageView fitHeight="135.0" fitWidth="118.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@544-5440422_back-arrow-icon-transparent-png-clipart-free-download.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
   </children>
</AnchorPane>
