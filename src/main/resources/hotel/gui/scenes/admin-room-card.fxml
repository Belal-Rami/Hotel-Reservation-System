<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
    ROOT = plain VBox card injected into the FlowPane in admin-rooms.fxml.
    NO AnchorPane/ImageView — the background lives in the parent.
    Dark glass style so cards pop against the dark overlay.
-->
<VBox prefWidth="320.0" prefHeight="240.0"
      spacing="12.0"
      alignment="TOP_LEFT"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hotel.gui.controllers.AdminRoomCardController"
      style="-fx-background-color: rgba(15,10,30,0.82);
             -fx-background-radius: 18;
             -fx-border-color: rgba(255,255,255,0.22);
             -fx-border-radius: 18;
             -fx-border-width: 1.5;
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.75), 18, 0, 0, 6);">
   <padding>
      <Insets top="22.0" right="22.0" bottom="22.0" left="22.0" />
   </padding>
   <children>

      <!-- Room number -->
      <Label fx:id="roomNumberLabel"
             text="Room 101"
             textFill="WHITE">
         <font><Font name="Arial Bold" size="24.0" /></font>
      </Label>

      <!-- Room type -->
      <Label fx:id="roomTypeLabel"
             text="Standard Single"
             textFill="rgba(200,200,255,0.75)">
         <font><Font size="15.0" /></font>
      </Label>

      <Separator style="-fx-background-color: rgba(255,255,255,0.25); -fx-padding: 2 0 2 0;" />

      <!-- Amenities -->
      <Label fx:id="amenitiesLabel"
             text="Wifi, TV, Minibar"
             wrapText="true"
             textFill="rgba(180,220,255,0.60)"
             VBox.vgrow="ALWAYS">
         <font><Font size="13.0" /></font>
      </Label>

      <Region VBox.vgrow="ALWAYS" />

      <!-- Buttons -->
      <HBox spacing="12.0" alignment="CENTER_LEFT">
         <VBox.margin><Insets top="6.0" /></VBox.margin>
         <children>
            <Button mnemonicParsing="false"
                    onAction="#handleEdit"
                    prefHeight="44.0" prefWidth="126.0"
                    text="Edit"
                    style="-fx-background-color: rgba(243,156,18,0.92);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(243,156,18,0.45), 8, 0, 0, 3);">
               <font><Font name="Arial Bold" size="16.0" /></font>
            </Button>
            <Button mnemonicParsing="false"
                    onAction="#handleDelete"
                    prefHeight="44.0" prefWidth="126.0"
                    text="Delete"
                    style="-fx-background-color: rgba(217,48,37,0.92);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(217,48,37,0.45), 8, 0, 0, 3);">
               <font><Font name="Arial Bold" size="16.0" /></font>
            </Button>
         </children>
      </HBox>

   </children>
</VBox>
