<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hotel.gui.controllers.AdminRoomCardController">
   <children>

      <!-- ── Background image ── -->
      <ImageView fitHeight="1080.0" fitWidth="1920.0"
                 layoutX="0.0" layoutY="0.0"
                 pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@Gemini_Generated_Image_wuxsypwuxsypwuxs.png" />
         </image>
      </ImageView>

      <!-- ── Dark overlay ── -->
      <AnchorPane layoutX="0.0" layoutY="0.0"
                  prefHeight="1080.0" prefWidth="1920.0"
                  style="-fx-background-color: rgba(0,0,0,0.60);" />

      <!-- ── Room card centred on screen ── -->
      <VBox layoutX="760.0" layoutY="280.0"
            prefWidth="400.0" spacing="18.0"
            alignment="TOP_LEFT"
            style="-fx-background-color: rgba(255,255,255,0.07);
                     -fx-background-radius: 20;
                     -fx-border-color: rgba(255,255,255,0.12);
                     -fx-border-radius: 20;
                     -fx-border-width: 1;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.45), 16, 0, 0, 6);">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>

            <Label fx:id="roomNumberLabel"
                   text="Room 101"
                   textFill="WHITE">
               <font><Font name="Arial Bold" size="32.0" /></font>
            </Label>

            <Label fx:id="roomTypeLabel"
                   text="Standard Single"
                   textFill="rgba(255,255,255,0.60)">
               <font><Font size="20.0" /></font>
            </Label>

            <Separator style="-fx-background-color: rgba(255,255,255,0.20);" />

            <Label fx:id="amenitiesLabel"
                   text="Wifi, TV, Minibar"
                   wrapText="true"
                   textFill="rgba(255,255,255,0.45)"
                   VBox.vgrow="ALWAYS">
               <font><Font size="17.0" /></font>
            </Label>

            <Region VBox.vgrow="ALWAYS" />

            <HBox spacing="16.0" alignment="CENTER_LEFT">
               <VBox.margin><Insets top="10.0" /></VBox.margin>
               <children>
                  <Button mnemonicParsing="false"
                          onAction="#handleEdit"
                          prefHeight="56.0" prefWidth="140.0"
                          text="Edit"
                          style="-fx-background-color: rgba(243,156,18,0.85);
                                       -fx-background-radius: 10;
                                       -fx-text-fill: white;
                                       -fx-cursor: hand;">
                     <font><Font name="Arial Bold" size="20.0" /></font>
                  </Button>
                  <Button mnemonicParsing="false"
                          onAction="#handleDelete"
                          prefHeight="56.0" prefWidth="140.0"
                          text="Delete"
                          style="-fx-background-color: rgba(217,48,37,0.85);
                                       -fx-background-radius: 10;
                                       -fx-text-fill: white;
                                       -fx-cursor: hand;">
                     <font><Font name="Arial Bold" size="20.0" /></font>
                  </Button>
               </children>
            </HBox>

         </children>
      </VBox>

   </children>
</AnchorPane>
