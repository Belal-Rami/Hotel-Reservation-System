<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Plain VBox popup — injected into a Dialog/Stage by the controller.
     No background image here; the parent window shows the bg. -->
<VBox spacing="16.0"
      prefWidth="520.0" prefHeight="580.0"
      alignment="TOP_LEFT"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hotel.gui.controllers.AdminRoomEditorController"
      style="-fx-background-color: rgba(18,18,35,0.97);
             -fx-background-radius: 20;
             -fx-border-color: rgba(255,255,255,0.18);
             -fx-border-radius: 20;
             -fx-border-width: 1;
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.70), 24, 0, 0, 8);">
    <padding>
        <Insets top="36.0" right="40.0" bottom="36.0" left="40.0" />
    </padding>
    <children>

        <!-- Title -->
        <Label fx:id="headerLabel"
               text="Room Editor"
               textFill="WHITE">
            <font><Font name="Arial Bold" size="34.0" /></font>
            <VBox.margin><Insets bottom="8.0" /></VBox.margin>
        </Label>

        <!-- Room Number -->
        <Label text="Room Number:"
               textFill="rgba(255,255,255,0.65)">
            <font><Font name="Arial Bold" size="16.0" /></font>
        </Label>
        <TextField fx:id="roomNumberField"
                   promptText="e.g. 101"
                   prefHeight="50.0"
                   style="-fx-background-color: rgba(255,255,255,0.10);
                          -fx-background-radius: 10;
                          -fx-border-color: rgba(255,255,255,0.30);
                          -fx-border-radius: 10;
                          -fx-text-fill: white;
                          -fx-prompt-text-fill: rgba(255,255,255,0.38);
                          -fx-font-size: 16px;
                          -fx-padding: 0 12 0 12;" />

        <!-- Room Type -->
        <Label text="Room Type:"
               textFill="rgba(255,255,255,0.65)">
            <font><Font name="Arial Bold" size="16.0" /></font>
        </Label>
        <ComboBox fx:id="roomTypeComboBox"
                  maxWidth="1.7976931348623157E308"
                  prefHeight="50.0"
                  promptText="Select a Type..."
                  style="-fx-background-color: rgba(255,255,255,0.10);
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(255,255,255,0.30);
                         -fx-border-radius: 10;
                         -fx-text-fill: white;
                         -fx-font-size: 16px;" />

        <!-- Amenities -->
        <Label text="Included Amenities:"
               textFill="rgba(255,255,255,0.65)">
            <font><Font name="Arial Bold" size="16.0" /></font>
        </Label>
        <ScrollPane fitToWidth="true"
                    prefHeight="150.0"
                    style="-fx-background-color: rgba(255,255,255,0.06);
                           -fx-background-radius: 10;
                           -fx-border-color: rgba(255,255,255,0.22);
                           -fx-border-radius: 10;
                           -fx-control-inner-background: transparent;"
                    VBox.vgrow="ALWAYS">
            <VBox fx:id="amenitiesBox"
                  spacing="8.0"
                  style="-fx-background-color: transparent;">
                <padding>
                    <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                </padding>
            </VBox>
        </ScrollPane>

        <!-- Error label -->
        <Label fx:id="errorLabel"
               textFill="rgba(255,80,80,0.95)"
               wrapText="true"
               style="-fx-font-weight: bold; -fx-font-size: 14px;" />

        <!-- Buttons -->
        <HBox spacing="16.0" alignment="CENTER_RIGHT">
            <VBox.margin><Insets top="4.0" /></VBox.margin>
            <children>
                <Button mnemonicParsing="false"
                        text="Cancel"
                        onAction="#handleCancel"
                        prefHeight="52.0" prefWidth="150.0"
                        style="-fx-background-color: rgba(255,255,255,0.10);
                               -fx-background-radius: 10;
                               -fx-border-color: rgba(255,255,255,0.25);
                               -fx-border-radius: 10;
                               -fx-text-fill: rgba(255,255,255,0.80);
                               -fx-cursor: hand;">
                    <font><Font name="Arial Bold" size="18.0" /></font>
                </Button>
                <Button mnemonicParsing="false"
                        text="Save Room"
                        onAction="#handleSave"
                        prefHeight="52.0" prefWidth="170.0"
                        style="-fx-background-color: rgba(40,160,75,0.85);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-cursor: hand;">
                    <font><Font name="Arial Bold" size="18.0" /></font>
                </Button>
            </children>
        </HBox>

    </children>
</VBox>
