<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hotel.gui.controllers.AdminCatalogController">
   <children>

      <!-- ── Background image ── -->
      <ImageView fitHeight="1080.0" fitWidth="1920.0"
                 layoutX="0.0" layoutY="0.0"
                 pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@Gemini_Generated_Image_wuxsypwuxsypwuxs.png" />
         </image>
      </ImageView>

      <!-- ── Dark overlay panel ── -->
      <AnchorPane layoutX="60.0" layoutY="40.0"
                  prefHeight="1000.0" prefWidth="1800.0"
                  style="-fx-background-color: rgba(0,0,0,0.55);
                           -fx-background-radius: 20;" />

      <!-- ── Page Title ── -->
      <Label layoutX="100.0" layoutY="55.0"
             prefHeight="100.0"
             text="System Catalog" textFill="WHITE">
         <font><Font name="Arial Bold" size="64.0" /></font>
      </Label>

      <!-- ── Two-column layout ── -->
      <HBox layoutX="80.0" layoutY="175.0"
            prefHeight="860.0" prefWidth="1760.0"
            spacing="0.0">
         <children>

            <!-- ===== Amenities Column ===== -->
            <VBox spacing="18.0" HBox.hgrow="ALWAYS">

               <HBox alignment="CENTER_LEFT" spacing="16.0">
                  <Label text="Amenities" textFill="WHITE">
                     <font><Font name="Arial Bold" size="40.0" /></font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="createAmenityBtn"
                          mnemonicParsing="false"
                          onAction="#createNewAmenity"
                          prefHeight="60.0" prefWidth="230.0"
                          text="+ Create Amenity"
                          style="-fx-background-color: rgba(40,160,75,0.85);
                                       -fx-background-radius: 10;
                                       -fx-text-fill: white;
                                       -fx-cursor: hand;">
                     <font><Font name="Arial Bold" size="20.0" /></font>
                  </Button>
               </HBox>

               <!-- Sub-headers -->
               <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 8 0 8;">
                  <Label text="Name" prefWidth="320.0"
                         textFill="rgba(255,255,255,0.45)">
                     <font><Font name="Arial Bold" size="17.0" /></font>
                  </Label>
                  <Label text="Price"
                         textFill="rgba(255,255,255,0.45)">
                     <font><Font name="Arial Bold" size="17.0" /></font>
                  </Label>
               </HBox>

               <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;
                                       -fx-control-inner-background: transparent;
                                       -fx-border-color: transparent;">
                  <VBox fx:id="amenitiesGrid" spacing="10.0"
                        style="-fx-background-color: transparent;" />
               </ScrollPane>
            </VBox>

            <!-- ── Vertical divider ── -->
            <Separator orientation="VERTICAL"
                       style="-fx-background-color: rgba(255,255,255,0.20);">
               <HBox.margin><Insets left="30.0" right="30.0" /></HBox.margin>
            </Separator>

            <!-- ===== Room Types Column ===== -->
            <VBox spacing="18.0" HBox.hgrow="ALWAYS">

               <HBox alignment="CENTER_LEFT" spacing="16.0">
                  <Label text="Room Types" textFill="WHITE">
                     <font><Font name="Arial Bold" size="40.0" /></font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="createRoomTypeBtn"
                          mnemonicParsing="false"
                          onAction="#createNewRoomType"
                          prefHeight="60.0" prefWidth="250.0"
                          text="+ Create Room Type"
                          style="-fx-background-color: rgba(40,160,75,0.85);
                                       -fx-background-radius: 10;
                                       -fx-text-fill: white;
                                       -fx-cursor: hand;">
                     <font><Font name="Arial Bold" size="20.0" /></font>
                  </Button>
               </HBox>

               <!-- Sub-headers -->
               <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 8 0 8;">
                  <Label text="Name" prefWidth="320.0"
                         textFill="rgba(255,255,255,0.45)">
                     <font><Font name="Arial Bold" size="17.0" /></font>
                  </Label>
                  <Label text="Price"
                         textFill="rgba(255,255,255,0.45)">
                     <font><Font name="Arial Bold" size="17.0" /></font>
                  </Label>
               </HBox>

               <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;
                                       -fx-control-inner-background: transparent;
                                       -fx-border-color: transparent;">
                  <VBox fx:id="roomTypesGrid" spacing="10.0"
                        style="-fx-background-color: transparent;" />
               </ScrollPane>
            </VBox>

         </children>
      </HBox>

   </children>
</AnchorPane>

