<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hotel.gui.controllers.AdminRoomsController">
   <children>

      <!-- ── Background image ── -->
      <ImageView fitHeight="1080.0" fitWidth="1920.0"
                 layoutX="0.0" layoutY="0.0"
                 pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@Gemini_Generated_Image_wuxsypwuxsypwuxs.png" />
         </image>
      </ImageView>

      <!-- ── Dark overlay — full screen so background shows everywhere ── -->
      <AnchorPane layoutX="0.0" layoutY="0.0"
                  prefHeight="1080.0" prefWidth="1920.0"
                  style="-fx-background-color: rgba(0,0,0,0.62);" />

      <!-- ── Header bar ── -->
      <AnchorPane layoutX="0.0" layoutY="0.0"
                  prefHeight="150.0" prefWidth="1920.0"
                  style="-fx-background-color: rgba(0,0,0,0.45);" />

      <!-- ── Page Title ── -->
      <Label layoutX="40.0" layoutY="44.0"
             text="Manage Physical Rooms"
             textFill="WHITE">
         <font><Font name="Arial Bold" size="58.0" /></font>
      </Label>

      <!-- ── Add Room Button ── -->
      <Button layoutX="1590.0" layoutY="50.0"
              mnemonicParsing="false"
              onAction="#openAddRoomPopup"
              prefHeight="58.0" prefWidth="250.0"
              text="+ Add New Room"
              style="-fx-background-color: rgba(40,160,75,0.90);
                       -fx-background-radius: 12;
                       -fx-text-fill: white;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(three-pass-box, rgba(40,160,75,0.50), 10, 0, 0, 4);">
         <font><Font name="Arial Bold" size="20.0" /></font>
      </Button>

      <!-- ── Scrollable room grid ── -->
      <!-- viewport-fill and control-inner-background forced transparent -->
      <ScrollPane layoutX="0.0" layoutY="150.0"
                  prefHeight="930.0" prefWidth="1920.0"
                  fitToWidth="true"
                  hbarPolicy="NEVER"
                  pannable="false"
                  style="-fx-background: transparent;
                           -fx-background-color: transparent;
                           -fx-control-inner-background: transparent;
                           -fx-border-color: transparent;
                           -fx-padding: 0;">
         <content>
            <FlowPane fx:id="roomsGrid"
                      orientation="HORIZONTAL"
                      hgap="22.0" vgap="22.0"
                      style="-fx-background-color: transparent;
                                 -fx-padding: 24 30 24 30;">
            </FlowPane>
         </content>
      </ScrollPane>

   </children>
</AnchorPane>
