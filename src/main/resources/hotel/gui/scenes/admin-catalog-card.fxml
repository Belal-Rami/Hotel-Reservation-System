<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hotel.gui.controllers.AdminCatalogCardController">
   <children>

      <!-- ── Background image ── -->
      <ImageView fitHeight="1080.0" fitWidth="1920.0"
                 layoutX="0.0" layoutY="0.0"
                 pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@Gemini_Generated_Image_wuxsypwuxsypwuxs.png" />
         </image>
      </ImageView>

      <!-- ── Dark overlay ── -->
      <AnchorPane layoutX="0.0" layoutY="0.0"
                  prefHeight="1080.0" prefWidth="1920.0"
                  style="-fx-background-color: rgba(0,0,0,0.60);" />

      <!-- ── Catalog row card ── -->
      <HBox layoutX="260.0" layoutY="490.0"
            prefWidth="1400.0" prefHeight="90.0"
            alignment="CENTER_LEFT" spacing="20.0"
            style="-fx-background-color: rgba(255,255,255,0.07);
                     -fx-background-radius: 14;
                     -fx-border-color: rgba(255,255,255,0.12);
                     -fx-border-radius: 14;
                     -fx-border-width: 1;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.30), 8, 0, 0, 3);">
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
         </padding>
         <children>

            <Label fx:id="nameLabel"
                   text="ItemName"
                   prefWidth="350.0"
                   textFill="WHITE">
               <font><Font name="Arial Bold" size="24.0" /></font>
            </Label>

            <Label fx:id="priceLabel"
                   text="ItemPrice"
                   prefWidth="200.0"
                   textFill="rgba(120,220,140,1.0)">
               <font><Font name="Arial Bold" size="24.0" /></font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="editBtn"
                    mnemonicParsing="false"
                    onAction="#editItem"
                    prefHeight="58.0" prefWidth="140.0"
                    text="Edit"
                    style="-fx-background-color: rgba(243,156,18,0.85);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-cursor: hand;">
               <font><Font name="Arial Bold" size="20.0" /></font>
            </Button>

            <Button fx:id="deleteBtn"
                    mnemonicParsing="false"
                    onAction="#deleteItem"
                    prefHeight="58.0" prefWidth="150.0"
                    text="Delete"
                    style="-fx-background-color: rgba(217,48,37,0.85);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-cursor: hand;">
               <font><Font name="Arial Bold" size="20.0" /></font>
            </Button>

         </children>
      </HBox>

   </children>
</AnchorPane>
