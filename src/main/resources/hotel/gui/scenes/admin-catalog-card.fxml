<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #eeeeee;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hotel.gui.controllers.AdminCatalogCardController">
   <children>
      <Label fx:id="nameLabel" prefHeight="49.0" prefWidth="164.0" text="ItemName">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="priceLabel" prefHeight="23.0" prefWidth="147.0" text="ItemPrice">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Pane prefHeight="70.0" prefWidth="270.0" HBox.hgrow="ALWAYS" />
      <Button fx:id="editBtn" mnemonicParsing="false" onAction="#editItem" prefHeight="48.0" prefWidth="92.0" style="-fx-background-color: #F39C12;" styleClass="btn-orange" text="Edit">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Button fx:id="deleteBtn" layoutX="743.0" layoutY="36.0" mnemonicParsing="false" onAction="#deleteItem" prefHeight="48.0" prefWidth="120.0" styleClass="btn-green" text="Delete">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</HBox>
