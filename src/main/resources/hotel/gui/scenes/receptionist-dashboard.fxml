<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hotel.gui.controllers.ReceptionistDashboardController">

   <children>

      <!-- ── Background ── -->
      <ImageView fitHeight="1080.0" fitWidth="1980.0" layoutX="-54.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Gemini_Generated_Image_wuxsypwuxsypwuxs.png" />
         </image>
      </ImageView>

      <!-- ── Dark overlay panel ── -->
      <AnchorPane layoutX="60.0" layoutY="40.0" prefHeight="1000.0" prefWidth="1800.0" style="-fx-background-color: rgba(0,0,0,0.55);                            -fx-background-radius: 20;" />

      <!-- ── Page Title ── -->
      <Label layoutX="230.0" layoutY="48.0" prefHeight="110.0" prefWidth="1200.0" text="Receptionist Dashboard" textFill="WHITE">
         <font><Font name="Arial Bold" size="80.0" /></font>
      </Label>

      <!-- ── Menu Buttons – centred VBox ── -->
      <VBox alignment="CENTER" layoutX="610.0" layoutY="260.0" prefWidth="700.0" spacing="40.0">

         <!-- Reservations -->
         <Button mnemonicParsing="false" onAction="#openreservation" prefHeight="140.0" prefWidth="700.0" style="-fx-background-color: rgba(255,255,255,0.10);                            -fx-background-radius: 16;                            -fx-text-fill: white;                            -fx-cursor: hand;                            -fx-border-color: rgba(255,255,255,0.25);                            -fx-border-radius: 16;                            -fx-border-width: 1.5;" text="Reservations">
            <font><Font name="Arial Bold" size="40.0" /></font>
         </Button>

         <!-- Rooms -->
         <Button mnemonicParsing="false" onAction="#openrooms" prefHeight="140.0" prefWidth="700.0" style="-fx-background-color: rgba(255,255,255,0.10);                            -fx-background-radius: 16;                            -fx-text-fill: white;                            -fx-cursor: hand;                            -fx-border-color: rgba(255,255,255,0.25);                            -fx-border-radius: 16;                            -fx-border-width: 1.5;" text="Rooms">
            <font><Font name="Arial Bold" size="40.0" /></font>
         </Button>

         <!-- Guests -->
         <Button mnemonicParsing="false" onAction="#openguests" prefHeight="140.0" prefWidth="700.0" style="-fx-background-color: rgba(255,255,255,0.10);                            -fx-background-radius: 16;                            -fx-text-fill: white;                            -fx-cursor: hand;                            -fx-border-color: rgba(255,255,255,0.25);                            -fx-border-radius: 16;                            -fx-border-width: 1.5;" text="Guests">
            <font><Font name="Arial Bold" size="40.0" /></font>
         </Button>

         <!-- Log Out -->
         <Button mnemonicParsing="false" onAction="#logout" prefHeight="140.0" prefWidth="700.0" style="-fx-background-color: rgba(210,60,60,0.75);                            -fx-background-radius: 16;                            -fx-text-fill: white;                            -fx-cursor: hand;                            -fx-border-color: rgba(255,255,255,0.20);                            -fx-border-radius: 16;                            -fx-border-width: 1.5;" text="Log Out">
            <font><Font name="Arial Bold" size="40.0" /></font>
         </Button>

      </VBox>

   </children>
</AnchorPane>
