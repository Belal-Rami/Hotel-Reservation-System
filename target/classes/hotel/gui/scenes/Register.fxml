<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hotel.gui.controllers.RegisterController">
   <children>
      <VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" style="-fx-background-radius: 50;">
         <children>
            <Label prefHeight="1080.0" prefWidth="1920.0" text="Create New Account">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <TextField fx:id="regUsernameField" promptText="Username" style="-fx-background-radius: 20; -fx-padding: 10;" />
            <PasswordField fx:id="regPasswordField" promptText="Password" style="-fx-background-radius: 20; -fx-padding: 10;" />
            <TextField fx:id="regEmailField" promptText="Email" style="-fx-background-radius: 20; -fx-padding: 10;" />
            <TextField fx:id="regPhoneField" promptText="Phone Nummber" style="-fx-background-radius: 20; -fx-padding: 10;" />
            <TextField onAction="#handleRegister" promptText="Create Account" style="-fx-background-radius: 20; -fx-padding: 10;" />
         </children>
      </VBox>
   </children>
</AnchorPane>
