<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: linear-gradient(to left, #5a121b, #a62030);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hotel.gui.controllers.StartScreenController">
   <children>

      <!-- Background Image -->
      <ImageView fitHeight="1080.0" fitWidth="1920.0" pickOnBounds="true" preserveRatio="true">

         <image>
            <Image url="@Lokanda.png" />
         </image>

         <effect>
            <DropShadow spread="0.1" />
         </effect>
      </ImageView>

      <!-- Main Buttons -->
      <HBox alignment="CENTER" spacing="300.0" AnchorPane.bottomAnchor="250.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

         <children>
         <!-- Guest Button -->
         <Button fx:id="guestBtn" mnemonicParsing="false" onAction="#handleGuestAction" prefHeight="168.0" prefWidth="340.0" style="-fx-background-color: #EFD16D; -fx-background-radius: 30;" text="Guest">

            <font>
               <Font name="System Bold" size="48.0" />
            </font>

         </Button>

            <Button fx:id="receptionistBtn" mnemonicParsing="false" onAction="#handleReceptionistAction" prefHeight="176.0" prefWidth="391.0" style="-fx-background-color: #EFD16D; -fx-background-radius: 30;" text="Receptionist">

               <font>
                  <Font name="System Bold" size="48.0" />
               </font>

            </Button>

            <!-- Admin Button -->
            <Button fx:id="adminBtn" mnemonicParsing="false" onAction="#handleAdminAction" prefHeight="188.0" prefWidth="332.0" style="-fx-background-color: #EFD16D; -fx-background-radius: 30;" text="Admin">
               <font>
                  <Font name="System Bold" size="48.0" />
               </font>
            </Button>

         </children>
      </HBox>

   </children>

</AnchorPane>
