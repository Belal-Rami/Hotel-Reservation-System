<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hotel.gui.controllers.AdminCreateItemController">
   <children>

      <!-- ── Background image ── -->
      <ImageView fitHeight="1080.0" fitWidth="1920.0"
                 layoutX="0.0" layoutY="0.0"
                 pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@Gemini_Generated_Image_wuxsypwuxsypwuxs.png" />
         </image>
      </ImageView>

      <!-- ── Dark overlay ── -->
      <AnchorPane layoutX="0.0" layoutY="0.0"
                  prefHeight="1080.0" prefWidth="1920.0"
                  style="-fx-background-color: rgba(0,0,0,0.60);" />

      <!-- ── Create item glass card centred ── -->
      <VBox layoutX="660.0" layoutY="300.0"
            prefWidth="600.0"
            spacing="26.0"
            alignment="CENTER"
            style="-fx-background-color: rgba(255,255,255,0.07);
                     -fx-background-radius: 20;
                     -fx-border-color: rgba(255,255,255,0.15);
                     -fx-border-radius: 20;
                     -fx-border-width: 1;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.50), 20, 0, 0, 8);">
         <padding>
            <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
         </padding>
         <children>

            <!-- Title -->
            <Label fx:id="headerLabel"
                   text="Create New Item"
                   textFill="WHITE">
               <font><Font name="Arial Bold" size="36.0" /></font>
               <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </Label>

            <!-- Item Name -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <Label fx:id="namePromptLabel"
                      prefWidth="180.0"
                      text="Item Name:"
                      textFill="rgba(255,255,255,0.65)">
                  <font><Font name="Arial Bold" size="22.0" /></font>
               </Label>
               <TextField fx:id="nameField"
                          prefHeight="58.0"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.10);
                                      -fx-background-radius: 10;
                                      -fx-border-color: rgba(255,255,255,0.30);
                                      -fx-border-radius: 10;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.38);
                                      -fx-font-size: 22px;
                                      -fx-padding: 0 12 0 12;" />
            </HBox>

            <!-- Base Price -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <Label prefWidth="180.0"
                      text="Base Price ($):"
                      textFill="rgba(255,255,255,0.65)">
                  <font><Font name="Arial Bold" size="22.0" /></font>
               </Label>
               <TextField fx:id="priceField"
                          prefHeight="58.0"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.10);
                                      -fx-background-radius: 10;
                                      -fx-border-color: rgba(255,255,255,0.30);
                                      -fx-border-radius: 10;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.38);
                                      -fx-font-size: 22px;
                                      -fx-padding: 0 12 0 12;" />
            </HBox>

            <!-- Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="20.0">
               <VBox.margin><Insets top="10.0" /></VBox.margin>
               <children>
                  <Button mnemonicParsing="false"
                          onAction="#handleCancel"
                          prefHeight="62.0" prefWidth="170.0"
                          text="Cancel"
                          style="-fx-background-color: rgba(217,48,37,0.85);
                                       -fx-background-radius: 10;
                                       -fx-text-fill: white;
                                       -fx-cursor: hand;">
                     <font><Font name="Arial Bold" size="22.0" /></font>
                  </Button>
                  <Button mnemonicParsing="false"
                          onAction="#handleSave"
                          prefHeight="62.0" prefWidth="180.0"
                          text="Save Item"
                          style="-fx-background-color: rgba(40,160,75,0.85);
                                       -fx-background-radius: 10;
                                       -fx-text-fill: white;
                                       -fx-cursor: hand;">
                     <font><Font name="Arial Bold" size="22.0" /></font>
                  </Button>
               </children>
            </HBox>

         </children>
      </VBox>

   </children>
</AnchorPane>
