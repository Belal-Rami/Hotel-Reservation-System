<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<!--
    ROOT = plain HBox row injected into amenitiesGrid / roomTypesGrid VBox.
    No AnchorPane/ImageView — background lives in the parent.
    Dark glass style so rows pop against the dark background.
-->
<HBox alignment="CENTER_LEFT"
      prefHeight="74.0"
      spacing="16.0"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hotel.gui.controllers.AdminCatalogCardController"
      style="-fx-background-color: rgba(15,10,30,0.82);
             -fx-background-radius: 12;
             -fx-border-color: rgba(255,255,255,0.22);
             -fx-border-radius: 12;
             -fx-border-width: 1.5;
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.65), 10, 0, 0, 4);">
   <padding>
      <Insets top="12.0" right="18.0" bottom="12.0" left="18.0" />
   </padding>
   <children>

      <Label fx:id="nameLabel"
             text="ItemName"
             prefWidth="260.0"
             textFill="WHITE">
         <font><Font name="Arial Bold" size="19.0" /></font>
      </Label>

      <Label fx:id="priceLabel"
             text="0.00"
             prefWidth="150.0"
             textFill="rgba(120,230,150,1.0)">
         <font><Font name="Arial Bold" size="19.0" /></font>
      </Label>

      <Region HBox.hgrow="ALWAYS" />

      <Button fx:id="editBtn"
              mnemonicParsing="false"
              onAction="#editItem"
              prefHeight="46.0" prefWidth="108.0"
              text="Edit"
              style="-fx-background-color: rgba(243,156,18,0.92);
                       -fx-background-radius: 10;
                       -fx-text-fill: white;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(three-pass-box, rgba(243,156,18,0.45), 8, 0, 0, 3);">
         <font><Font name="Arial Bold" size="16.0" /></font>
      </Button>

      <Button fx:id="deleteBtn"
              mnemonicParsing="false"
              onAction="#deleteItem"
              prefHeight="46.0" prefWidth="116.0"
              text="Delete"
              style="-fx-background-color: rgba(217,48,37,0.92);
                       -fx-background-radius: 10;
                       -fx-text-fill: white;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(three-pass-box, rgba(217,48,37,0.45), 8, 0, 0, 3);">
         <font><Font name="Arial Bold" size="16.0" /></font>
      </Button>

   </children>
</HBox>
