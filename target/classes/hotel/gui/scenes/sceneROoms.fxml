<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hotel.gui.controllers.RoomsController">

   <children>

      <!-- Background -->
      <ImageView fitHeight="1080.0" fitWidth="1980.0" layoutX="-54.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Gemini_Generated_Image_wuxsypwuxsypwuxs.png" />
         </image>
      </ImageView>

      <!-- Back Button -->
      <Button contentDisplay="GRAPHIC_ONLY" layoutX="59.0" layoutY="53.0" mnemonicParsing="false" onAction="#switchScene1" prefHeight="85.0" prefWidth="110.0" style="-fx-background-color: transparent;" text="Button">
         <graphic>
            <ImageView fitHeight="135.0" fitWidth="118.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@544-5440422_back-arrow-icon-transparent-png-clipart-free-download.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>

      <!-- Title -->
      <Label layoutX="231.0" layoutY="5.0" prefHeight="214.0" prefWidth="675.0" text="Rooms" textFill="WHITE">
         <font>
            <Font name="Arial Bold" size="96.0" />
         </font>
      </Label>

      <!-- Top controls bar: day navigation + room type filter -->
      <HBox alignment="CENTER_LEFT" layoutX="65.0" layoutY="197.0" prefHeight="132.0" prefWidth="1848.0" spacing="16.0">

         <!-- Previous Day Button -->
         <Button fx:id="btnPrevDay" contentDisplay="GRAPHIC_ONLY" onAction="#prevDay" prefHeight="144.0" prefWidth="160.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;">
            <font>
               <Font size="69.0" />
            </font>
            <graphic>
               <ImageView fitHeight="142.0" fitWidth="171.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@c48bff88-2783-4bef-83ba-4d3f07879d2a-removebg-preview.png" />
                  </image>
               </ImageView>
            </graphic></Button>

         <!-- Current Date Label -->
         <Label fx:id="lblCurrentDate" alignment="CENTER" prefHeight="192.0" prefWidth="612.0" style="-fx-background-color: rgba(0,0,0,0.45); -fx-background-radius: 8; -fx-font-family: 'Arial Bold';" text="Today" textFill="WHITE">
            <font>
               <Font size="74.0" />
            </font></Label>

         <!-- Next Day Button -->
         <Button fx:id="btnNextDay" contentDisplay="GRAPHIC_ONLY" onAction="#nextDay" prefHeight="260.0" prefWidth="251.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;">
            <graphic>
               <ImageView fitHeight="122.0" fitWidth="155.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@c48bff88-2783-4bef-83ba-4d3f07879d2a-removebg-previews.png" />
                  </image>
               </ImageView>
            </graphic></Button>

         <!-- Spacer -->
         <Label prefWidth="40.0" />

         <!-- Room Type Filter Label -->
         <Label prefHeight="181.0" prefWidth="285.0" style="-fx-font-family: 'Arial Bold';" text="Type:" textFill="WHITE">
            <font>
               <Font size="80.0" />
            </font></Label>

         <!-- Room Type ComboBox -->
         <ComboBox fx:id="cmbRoomType" onAction="#filterByRoomType" prefHeight="132.0" prefWidth="311.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-text-fill: white; -fx-background-radius: 8;" />

      </HBox>

      <!-- Legend -->
      <HBox alignment="CENTER_LEFT" layoutX="1300.0" layoutY="42.0" prefHeight="82.0" prefWidth="489.0" spacing="20.0">
         <Label prefHeight="82.0" prefWidth="240.0" style="-fx-background-color: rgba(60,180,80,0.8); -fx-background-radius: 6; -fx-padding: 6 14; -fx-text-fill: white;" text="Available">
            <font>
               <Font size="48.0" />
            </font></Label>
         <Label prefHeight="82.0" prefWidth="261.0" style="-fx-background-color: rgba(210,60,60,0.8); -fx-background-radius: 6; -fx-padding: 6 14; -fx-text-fill: white;" text="Reserved">
            <font>
               <Font size="48.0" />
            </font></Label>
      </HBox>

      <!-- Room Cards TilePane -->
      <TilePane fx:id="tileRooms" hgap="20.0" layoutX="65.0" layoutY="433.0" prefColumns="5" prefHeight="582.0" prefWidth="1792.0" style="-fx-background-color: transparent;" vgap="20.0" />

   </children>
</AnchorPane>
