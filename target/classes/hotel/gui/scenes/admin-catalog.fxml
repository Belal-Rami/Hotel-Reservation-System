<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hotel.gui.controllers.AdminCatalogController">
   <children>
      <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-size: 60;" text="Hotel Setup" textAlignment="CENTER">
         <font>
            <Font size="60.0" />
         </font>
         <padding>
            <Insets top="10.0" />
         </padding>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </Label>
      <HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1080.0" prefWidth="1920.0">
         <children>
            <VBox prefHeight="400.0" prefWidth="0.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-size: 30;" text="Amenities" textAlignment="CENTER" VBox.vgrow="ALWAYS">
                     <font>
                        <Font size="42.0" />
                     </font>
                  </Label>
                  <HBox prefHeight="27.0" prefWidth="302.0">
                     <children>
                        <Label text="Name">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Pane prefHeight="27.0" prefWidth="147.0" />
                        <Label prefHeight="17.0" prefWidth="93.0" text="Price">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                  </HBox>
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="875.0" prefWidth="975.0">
                     <content>
                        <VBox fx:id="amenitiesGrid" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="955.0" spacing="10.0" />
                     </content>
                  </ScrollPane>
                  <HBox alignment="CENTER_LEFT" prefHeight="109.0" prefWidth="975.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Button fx:id="createAmenityBtn" mnemonicParsing="false" onAction="#createNewAmenity" prefHeight="60.0" prefWidth="122.0" text="Create Amenity" textAlignment="CENTER">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </Button>
                     </children>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="200.0">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </Separator>
            <VBox prefHeight="400.0" prefWidth="0.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-size: 30;" text="Room Types" textAlignment="CENTER">
                     <font>
                        <Font size="42.0" />
                     </font>
                  </Label>
                  <HBox prefHeight="27.0" prefWidth="302.0">
                     <children>
                        <Label text="Name">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
