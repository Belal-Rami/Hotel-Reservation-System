                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="875.0" prefWidth="975.0">
                     <content>
                        <VBox fx:id="roomTypesGrid" maxWidth="1.7976931348623157E308" prefWidth="973.0" spacing="10.0" />
                     </content>
                  </ScrollPane>
                  <HBox alignment="CENTER_LEFT" prefHeight="109.0" prefWidth="975.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Button fx:id="createRoomTypeBtn" mnemonicParsing="false" onAction="#createNewRoomType" prefHeight="60.0" prefWidth="148.0" text="Create Room Type" textAlignment="CENTER">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </Button>
                     </children>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
